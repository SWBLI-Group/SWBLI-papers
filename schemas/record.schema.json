{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SWBLI contribution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "authors",
    "year",
    "content",
    "board",
    "regimes",
    "real_gas",
    "methods",
    "geometry",
    "tags",
    "focus",
    "evidence",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "doi": { "type": "string" },
    "zotero_key": { "type": "string" },
    "title": { "type": "string", "minLength": 3 },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["first", "last"],
        "properties": {
          "first": { "type": "string" },
          "last": { "type": "string" }
        }
      }
    },
    "author_display": { "type": "string" },
    "year": { "type": ["string", "integer"] },
    "type": { "type": "string" },
    "journal": { "type": "string" },
    "journal_abbr": { "type": "string" },
    "volume": { "type": "string" },
    "issue": { "type": "string" },
    "pages": { "type": "string" },
    "publisher": { "type": "string" },
    "place": { "type": "string" },
    "edition": { "type": "string" },
    "isbn": { "type": "string" },
    "language": { "type": "string" },
    "abstract_orig": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "zotero_tags": { "type": "array", "items": { "type": "string" } },
    "collections": { "type": "array", "items": { "type": "string" } },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_zh", "gist", "abstract_zh", "main_work", "conclusions"],
      "properties": {
        "title_zh": { "type": "string" },
        "gist": { "type": "string", "maxLength": 40 },
        "abstract_zh": { "type": "string" },
        "background": { "type": "string" },
        "main_work": { "type": "string" },
        "method_detail": { "type": "string" },
        "findings": { "type": "string" },
        "conclusions": { "type": "string" },
        "limits": { "type": "string" },
        "problem_solved": { "type": "string" },
        "key_findings": { "type": "array", "items": { "type": "string" } },
        "derivation_idea": { "type": "string" },
        "derivation_steps": { "type": "array", "items": { "type": "string" } },
        "formula": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "expr", "idea"],
              "properties": {
                "name": { "type": "string" },
                "expr": { "type": "string" },
                "idea": { "type": "string" }
              }
            }
          ]
        },
        "review": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sections", "status", "gaps"],
              "properties": {
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "summary"],
                    "properties": {
                      "name": { "type": "string" },
                      "summary": { "type": "string" }
                    }
                  }
                },
                "status": { "type": "string" },
                "gaps": { "type": "string" }
              }
            }
          ]
        }
      }
    },
    "board": {
      "type": "array",
      "items": { "enum": ["流动分离", "初始分离", "峰值传热", "基础与工具"] }
    },
    "regimes": {
      "type": "array",
      "items": { "enum": ["层流", "转捩", "湍流", "无粘", "非定常", "多流态"] }
    },
    "real_gas": {
      "type": "array",
      "items": {
        "enum": [
          "真实气体效应",
          "壁面催化",
          "壁面适应",
          "振动能激发",
          "稀薄气体效应",
          "化学非平衡",
          "振动能非平衡"
        ]
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "enum": [
          "理论建模（控制方程）",
          "理论建模（数据驱动）",
          "稳定性分析",
          "实验研究",
          "数值模拟",
          "综述",
          "教材",
          "计算工具"
        ]
      }
    },
    "geometry": {
      "type": "array",
      "items": {
        "enum": [
          "压缩拐角",
          "平板",
          "平板入射激波",
          "双楔",
          "双锥",
          "轴对称",
          "多构型",
          "纯方程",
          "其他"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "enum": [
          "课题组文章",
          "层流",
          "转捩",
          "湍流",
          "无粘",
          "非定常",
          "真实气体效应",
          "壁面催化",
          "壁面适应",
          "振动能激发",
          "稀薄气体效应",
          "化学非平衡",
          "振动能非平衡",
          "流动分离",
          "传热建模",
          "经验关联",
          "数据驱动",
          "理论建模",
          "实验研究",
          "数值模拟",
          "稳定性分析",
          "三维效应",
          "计算工具",
          "无粘激波干扰",
          "教材",
          "综述",
          "非定常性",
          "压缩拐角",
          "平板",
          "平板入射激波",
          "双楔",
          "双锥",
          "轴对称",
          "多构型",
          "纯方程"
        ]
      }
    },
    "focus": {
      "type": "array",
      "items": {
        "enum": [
          "马赫数效应",
          "雷诺数效应",
          "壁温效应",
          "轴对称效应",
          "三维效应",
          "湍流效应",
          "动壁效应",
          "非定常效应",
          "稳定性",
          "主动控制"
        ]
      }
    },
    "evidence": {
      "enum": [
        "摘要+笔记",
        "摘要",
        "PDF全文",
        "PDF摘要/结论页",
        "PDF摘要/目录",
        "题录/公开摘要（原文摘要缺失）",
        "仅题录"
      ]
    },
    "confidence": { "enum": ["高", "中", "低"] },
    "pdf_file": { "type": "string" },
    "related": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "status": { "enum": ["active", "retracted", "superseded"] }
  }
}
